# ==============================================================
#   CB AGENT — YOUR API KEYS
# ==============================================================
#
#   HOW TO USE THIS FILE
#   1. Open it in Notepad (right-click -> Open with -> Notepad)
#   2. Paste your keys after the "=" signs below
#   3. Save (Ctrl + S) and close
#   4. Run:  python agent.py doctor
#
#   RULES
#   - No spaces around the "=".      Right: KEY=abc123
#                                    Wrong: KEY = abc123
#   - No quotes around values.       Right: KEY=abc123
#                                    Wrong: KEY="abc123"
#   - Blank lines are fine. Lines starting with # are ignored.
#
#   KEEP THIS FILE PRIVATE. These are passwords. Never post it,
#   email it, or put it in a public folder.
#
#   Need help getting a key? Double-click "3 - API KEY GUIDE.bat"
# ==============================================================


# --------------------------------------------------------------
#  REQUIRED — without this, the agent cannot think at all
# --------------------------------------------------------------
#  Get one at:  https://console.anthropic.com
#  Sign up -> Billing (add $5-10) -> API keys -> Create Key
#  It starts with:  sk-ant-
#  You can only see it once, so copy it straight in here.

ANTHROPIC_API_KEY=


# --------------------------------------------------------------
#  OPTIONAL — Instagram + Meta Ads
#  Gives you: real post performance, funnel analysis, ad results
# --------------------------------------------------------------
#  IMPORTANT: leave the two token lines BLANK.
#  You store your login by running:   python agent.py auth meta
#  (the agent saves it safely and renews it for you)

IG_ACCESS_TOKEN=
META_ACCESS_TOKEN=

#  Your Instagram business account number (a long number starting 1784...)
IG_BUSINESS_ID=

#  Your ad account, from the Ads Manager web address.
#  Look for "act=" in the URL, then write it like:  act_1234567890
META_AD_ACCOUNT_ID=

#  From your Meta app dashboard, under Settings -> Basic.
#  These let the agent renew your login automatically instead of
#  making you log in again every 60 days. Worth filling in.
META_APP_ID=
META_APP_SECRET=


# --------------------------------------------------------------
#  OPTIONAL — Shopify
#  Gives you: real orders and revenue in your reports
# --------------------------------------------------------------
#  Your store address (NOT your custom domain).
#  Find it in your Shopify admin web address.
#  Example:  my-brand.myshopify.com
SHOPIFY_STORE=

#  Newer Shopify apps give you these two on the app's
#  "Client credentials" page. The agent handles the rest.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

#  Older Shopify apps instead give one permanent token
#  starting with shpat_ . If you have that, put it here and
#  leave the two lines above blank.
SHOPIFY_ADMIN_TOKEN=


# --------------------------------------------------------------
#  OPTIONAL — Klaviyo
#  Gives you: email/SMS list growth tracking
# --------------------------------------------------------------
#  In Klaviyo: Settings -> API keys -> Create Private API Key
#  Use a READ-ONLY key with Lists and Profiles access.
#  It starts with:  pk_
KLAVIYO_PRIVATE_KEY=

#  The list you want tracked. Open that list in Klaviyo and copy
#  the short code from the web address (e.g. .../list/ABC123)
KLAVIYO_LIST_ID=


# --------------------------------------------------------------
#  OPTIONAL — TikTok
#  Requires TikTok to approve your app first, which takes days.
#  Skip this unless you specifically need TikTok numbers.
# --------------------------------------------------------------
TIKTOK_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=


# --------------------------------------------------------------
#  ADVANCED (leave alone unless you know what you're doing)
# --------------------------------------------------------------
#  Which Claude model to use. Default is a good balance of
#  quality and cost.
# CLAUDE_MODEL=claude-sonnet-5
